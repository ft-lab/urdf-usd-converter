<?xml version="1.0"?>
<!-- URDF 1.0: quat_xyzw is ignored with a warning, so rpy and quat_xyzw may both be present. -->
<robot name="warning_urdf_10_rpy_and_quat_xyzw" version="1.0">
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" quat_xyzw="0 0 0 1"/>
      <geometry>
        <box size="0.1 0.1 0.1"/>
      </geometry>
    </visual>
  </link>
</robot>
